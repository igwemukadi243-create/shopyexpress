# ==============================================================
# PASSERELLES PAIEMENT MOBILE MONEY RDC (M-Pesa, Airtel, Orange)
# Configurez ces clés en toute sécurité via le panneau "Secrets"
# dans l'interface AI Studio. Ne collez pas de clés réelles ici.
# ==============================================================

# 1. FlexPay RDC (Recommandé en RDC - https://flexpay.cd)
# Regroupe M-Pesa (Vodacom), Airtel Money, Orange Money et Cartes Visa/Mastercard.
FLEXPAY_API_TOKEN=YOUR_FLEXPAY_TOKEN
FLEXPAY_MERCHANT_CODE=YOUR_FLEXPAY_MERCHANT_CODE

# 2. iKeePay RDC (Alternative)
IKEEPAY_API_KEY=YOUR_IKEEPAY_API_KEY
IKEEPAY_SECRET_KEY=YOUR_IKEEPAY_SECRET_KEY
IKEEPAY_MERCHANT_ID=YOUR_IKEEPAY_MERCHANT_ID
